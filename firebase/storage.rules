rules_version = '2';

// Sprint 3 demo rules: any signed-in user can upload and read photos.
// Replace before real users (for example: only group members can read
// groups/{groupId}/photos, and only after the group's endsAt).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
