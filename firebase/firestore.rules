rules_version = '2';

// Sprint 3 demo rules: any signed-in user (including the playground's
// anonymous sign-in) can read and write. Fine for test data only.
// Replace with per-collection rules before real users (Sprint 4+).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
